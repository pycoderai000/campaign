# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, or local)
# Example: postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL=

# NextAuth (use: openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Meta (Facebook) Graph API – for Instagram Business metrics sync
# Get these from https://developers.facebook.com/ (App Dashboard → Settings → Basic)
META_APP_ID=
META_APP_SECRET=
# Page ID of the Facebook Page linked to your Instagram Business account
META_PAGE_ID=
# Long-lived Page access token (from Graph API Explorer or token exchange)
META_PAGE_ACCESS_TOKEN=
