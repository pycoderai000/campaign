# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, or local)
# Example: postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL=

# NextAuth (use: openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Meta (Facebook) Graph API – for Instagram Business metrics sync
# Get these from https://developers.facebook.com/ (App Dashboard → Settings → Basic)
META_APP_ID=
META_APP_SECRET=
# Optional override (default v21.0)
# META_GRAPH_API_VERSION=v21.0
# Page ID of the Facebook Page linked to your Instagram Business account
META_PAGE_ID=
# Long-lived Page access token (from Graph API Explorer or token exchange)
META_PAGE_ACCESS_TOKEN=

# AWS S3 – for all file/image uploads (deliverables, etc.)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Must match the region where your bucket was created (e.g. us-east-1, ap-south-1)
AWS_REGION=us-east-1
S3_BUCKET=
# Optional: force endpoint if you get "bucket must be addressed using the specified endpoint"
# S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
# Optional: custom base URL for S3 objects (e.g. CloudFront or custom domain)
# S3_PUBLIC_URL=https://your-bucket.s3.us-east-1.amazonaws.com
