# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, or local)
# Example: postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL=

# NextAuth (use: openssl rand -base64 32)
NEXTAUTH_SECRET=
# Must match the URL users open in the browser. Local dev: http://localhost:3000 (see npm run dev port).
# Production server: set to your public HTTPS origin (e.g. https://app.example.com).
# If local login fails while this points at production, set NEXTAUTH_URL_DEV=http://localhost:3000 or rely on next.config.js dev override.
NEXTAUTH_URL=http://localhost:3000
# Optional: override dev-only NextAuth origin (defaults to http://localhost:3000)
# NEXTAUTH_URL_DEV=http://localhost:3000

# Meta (Facebook) Graph API – for Instagram Business metrics sync
# Get these from https://developers.facebook.com/ (App Dashboard → Settings → Basic)
META_APP_ID=
META_APP_SECRET=
# Optional override (default v21.0)
# META_GRAPH_API_VERSION=v21.0
# Page ID of the Facebook Page linked to your Instagram Business account
META_PAGE_ID=
# Long-lived Page access token (from Graph API Explorer or token exchange)
META_PAGE_ACCESS_TOKEN=

# AWS S3 – for all file/image uploads (deliverables, etc.)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Must match the region where your bucket was created (e.g. us-east-1, ap-south-1)
AWS_REGION=us-east-1
S3_BUCKET=
# Optional: force endpoint if you get "bucket must be addressed using the specified endpoint"
# S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
# Optional: custom base URL for S3 objects (e.g. CloudFront or custom domain)
# S3_PUBLIC_URL=https://your-bucket.s3.us-east-1.amazonaws.com
#
# Private bucket (default): the app rewrites S3 URLs to /api/media?key=uploads/… (session cookie).
# Set NEXT_PUBLIC_DISABLE_S3_MEDIA_PROXY=1 only if the bucket allows public GetObject on uploads/*.
# Optional: comma-separated extra hostnames (custom CDN domain) for proxy rewriting:
# NEXT_PUBLIC_S3_MEDIA_EXTRA_HOSTS=media.example.com
